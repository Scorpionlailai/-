+                    digest.update(cpu.observed_mask.numpy().tobytes())
+                    digest.update(np.asarray([r.target_start for r in cpu.refs], dtype=np.int64).tobytes())
+                    batch = cpu.to(device)
+                    tick = perf_counter()
