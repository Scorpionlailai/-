{
  "models": {
    "BRITS": {
      "kind": "imputer",
      "model": {
        "hidden_size": 108,
        "impute_weight": 0.3,
        "label_weight": 0.0
      },
      "notes": "No ETTh1-specific configuration: README example supplies hidden size, weight and batch omitted from default parser. Necessary adaptations are 48->96, 35->7, device-safe tensors, unused legacy import removal, and classification label_weight=0 because P4 has no labels. Preserve original summed ORT and consistency weights; do not use the SAITS-repository BRITS normalization. Validation checkpoint selection and shared forecast head are P4 extensions.",
      "revision": "fc0a3a472a6d99a6934e471d40c25ed0b029b501",
      "root": "artifacts/upstream/BRITS",
      "sources": [
        "https://github.com/caow13/BRITS",
        "README.md",
        "main.py",
        "models/rits.py",
        "models/brits.py"
      ],
      "training": {
        "batch_size": 64,
        "epochs": 1000,
        "learning_rate": 0.001,
        "loss": "0.3*(forward_ORT_sum + backward_ORT_sum) + 0.1*consistency_mae",
        "lradj": "constant",
        "patience": null,
        "precision": "float32",
        "selection_metric": "mae",
        "weight_decay": 0.0
      },
      "version": "original caow13/BRITS; README RITS_I example hyperparameters applied to BRITS"
    },
    "BiTGraph": {
      "kind": "forecast",
      "model": {
        "conv_channels": 8,
        "dropout": 0.3,
        "effective_topk": 7,
        "end_channels": 32,
        "layers": 3,
        "node_dim": 3,
        "paper_topk": 10,
        "residual_channels": 8,
        "skip_channels": 16
      },
      "notes": "Paper blocks 3 override ETTh1 code layers 2. Both graph construction and nconv selection use min(10,7)=7; release nconv hardcodes 5. This necessary change is isolated in the adapter. Validation selection uses P4 standardized MAE rather than the release inverse-scaled MAE. CUDA device 0 required.",
      "revision": "4f1d05bcc20bb3f5084bd1facc995478f84a40ed",
      "root": "artifacts/upstream/BiTGraph",
      "sources": [
        "https://proceedings.iclr.cc/paper_files/paper/2024/file/7f3b25e39e0f0330435d1ffc1d6fa193-Paper-Conference.pdf",
        "main.py",
        "README.md"
      ],
      "training": {
        "batch_size": 32,
        "epochs": 200,
        "learning_rate": 0.001,
        "loss": "forecast_mae",
        "lradj": "constant",
        "patience": null,
        "precision": "float32",
        "selection_metric": "mae",
        "weight_decay": 0.0
      },
      "version": "paper section 5.1 + released ETTh1 channels + README epoch limit"
    },
    "CRIB": {
      "kind": "forecast",
      "model": {
        "dropout": 0.1,
        "enc_num": 2,
