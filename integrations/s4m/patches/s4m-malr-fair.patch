+    def _fair_batch(self, batch):
+        (
+            seq_x,
+            seq_x_mask,
+            seq_y,
+            seq_y_mask,
+            seq_true_x,
+            seq_true_y,
+            max_idx,
+            min_idx,
+            max_value,
